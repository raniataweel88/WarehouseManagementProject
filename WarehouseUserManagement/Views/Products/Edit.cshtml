@model ProductFormViewModel


<form asp-action="Edit"
      method="post"
      data-ajax-modal>


    @Html.AntiForgeryToken()


    <input type="hidden"
           asp-for="ProductId" />


    <div class="modal-header">

        <h5 class="modal-title">
            تعديل بيانات الصنف
        </h5>


        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal">
        </button>

    </div>





    <div class="modal-body">


        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>



        <div class="row g-3">





            <div class="col-md-12">

                <label class="form-label">
                    اسم الصنف
                </label>


                <input asp-for="ProductName"
                       class="form-control" />


                <span asp-validation-for="ProductName"
                      class="text-danger">
                </span>


            </div>








            <div class="col-md-6">


                <label class="form-label">
                    التصنيف
                </label>



                <select asp-for="CategoryId"
                        class="form-select">


                    @foreach (var c in Model.CategoryOptions)
                    {

                        if (Model.CategoryId == c.CategoryId)
                        {

                            <option value="@c.CategoryId"
                                    selected>

                                @c.CategoryName

                            </option>

                        }
                        else
                        {

                            <option value="@c.CategoryId">

                                @c.CategoryName

                            </option>

                        }

                    }


                </select>



                <span asp-validation-for="CategoryId"
                      class="text-danger">
                </span>


            </div>








            <div class="col-md-6">


                <label class="form-label">
                    الوحدة
                </label>



                <input asp-for="Unit"
                       class="form-control" />


                <span asp-validation-for="Unit"
                      class="text-danger">
                </span>


            </div>









            <div class="col-md-6">


                <label class="form-label">
                    الباركود
                </label>


                <input asp-for="Barcode"
                       class="form-control"
                       autocomplete="off" />


                <span asp-validation-for="Barcode"
                      class="text-danger">
                </span>


            </div>









            <div class="col-md-6">


                <label class="form-label">
                    الحد الأدنى للكمية
                </label>



                <input asp-for="MinimumQuantity"
                       type="number"
                       step="0.001"
                       min="0"
                       class="form-control" />



                <span asp-validation-for="MinimumQuantity"
                      class="text-danger">
                </span>


            </div>









            <!-- Current Quantity -->


            <div class="col-md-6">


                <label class="form-label">
                    الكمية الحالية
                </label>



                <input asp-for="CurrentQuantity"
                       type="number"
                       step="0.001"
                       min="0"
                       class="form-control"
                       readonly
                       tabindex="-1"
                       style="background-color:#e9ecef; cursor:not-allowed;" />



                <span asp-validation-for="CurrentQuantity"
                      class="text-danger">
                </span>


            </div>









            <!-- Average Cost -->


            <div class="col-md-6">


                <label class="form-label">
                      السعر
                </label>



                <input asp-for="AverageCost"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control"
                       readonly
                       tabindex="-1"
                       style="background-color:#e9ecef; cursor:not-allowed;" />



                <span asp-validation-for="AverageCost"
                      class="text-danger">
                </span>


            </div>









            <div class="col-md-12">


           

            </div>





        </div>


    </div>








    <div class="modal-footer">


        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">

            إلغاء

        </button>



        <button type="submit"
                class="btn btn-Prim">

            حفظ التعديلات

        </button>



    </div>




</form>