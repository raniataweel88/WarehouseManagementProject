@model IEnumerable<Permission>
@{
    ViewData["Title"] = "الصلاحيات";
    var groups = Model.GroupBy(p => p.ModuleName).OrderBy(g => g.Key);
}

<div class="page-title">
    <h2>إدارة الصلاحيات</h2>
    <a class="btn btn-Prim" asp-action="Create">+ صلاحية جديدة</a>
</div>

@foreach (var group in groups)
{
    <div class="card">
        <h3>@group.Key</h3>
        <table>
            <thead>
                <tr>
                    <th>اسم الصلاحية</th>
                    <th>الوصف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in group)
                {
                    <tr>
                        <td>@p.PermissionName</td>
                        <td class="muted">@(p.Description ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
