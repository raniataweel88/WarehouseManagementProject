@model StockTakeReportViewModel
@{
    ViewData["Title"] = "تقرير الجرد";
}

<div class="page-title">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Index" class="btn btn-secondary">⟵ قائمة التقارير</a>
</div>

<div class="card">
    <form method="get" class="toolbar">
        <div class="form-group">
            <label>سند الجرد</label>
            <select name="StockTakeId">
                <option value="">الكل</option>
                @foreach (var s in Model.StockTakes)
                {
                    <option value="@s.StockTakeId" selected="@(Model.Filter.StockTakeId == s.StockTakeId)">@s.StockTakeDate.ToString("yyyy-MM-dd") (#@s.StockTakeId)</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label>من تاريخ</label>
            <input type="date" name="FromDate" value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group">
            <label>إلى تاريخ</label>
            <input type="date" name="ToDate" value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group">
            <label>الباركود</label>
            <input type="search" name="Barcode" value="@Model.Filter.Barcode" placeholder="اكتب أو امسح الباركود..." />
        </div>
        <div class="form-group">
            <label>التصنيف</label>
            <select name="CategoryId">
                <option value="">الكل</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.CategoryId" selected="@(Model.Filter.CategoryId == c.CategoryId)">@c.CategoryName</option>
                }
            </select>
        </div>
        <div class="form-group" style="align-self:flex-end;">
            <label style="display:flex; align-items:center; gap:6px;">
                <input type="checkbox" name="OnlyDifferences" value="true" checked="@Model.Filter.OnlyDifferences" />
                فقط الأصناف التي بها فرق
            </label>
        </div>
        <button type="submit" class="btn btn-Prim">بحث</button>
        <a href="@Url.Action("StockTakeReport")" class="btn btn-secondary">تفريغ</a>
    </form>
</div>

<div class="stats-grid" style="margin-top:16px;">
    <div class="stat-card">
        <div class="num">@Model.Rows.Count</div>
        <div class="label">عدد السطور</div>
    </div>
    <div class="stat-card">
        <div class="num">@Model.TotalShortage</div>
        <div class="label">إجمالي النقص</div>
    </div>
    <div class="stat-card">
        <div class="num">@Model.TotalSurplus</div>
        <div class="label">إجمالي الزيادة</div>
    </div>
</div>

<div class="card" style="margin-top:16px;">
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>تاريخ الجرد</th>
                    <th>الصنف</th>
                    <th>الباركود</th>
                    <th>التصنيف</th>
                    <th>كمية النظام</th>
                    <th>الكمية الفعلية</th>
                    <th>الفرق</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr class="@(r.Difference < 0 ? "status-warning" : "")">
                        <td class="muted">@r.StockTakeDate.ToString("yyyy-MM-dd")</td>
                        <td>@r.ProductName</td>
                        <td>@(r.Barcode ?? "-")</td>
                        <td>@(r.CategoryName ?? "-")</td>
                        <td>@r.SystemQuantity</td>
                        <td>@r.ActualQuantity</td>
                        <td>@(r.Difference > 0 ? "+" : "")@r.Difference</td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="7" class="muted" style="text-align:center; padding:24px;">لا يوجد نتائج</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
