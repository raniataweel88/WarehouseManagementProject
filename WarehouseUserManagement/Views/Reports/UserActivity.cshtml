@model UserActivityViewModel
@{
    ViewData["Title"] = "ملخص نشاط المستخدمين";
}

<div class="page-title">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Index" class="btn btn-secondary">⟵ قائمة التقارير</a>
</div>

<div class="card">
    <form method="get" class="toolbar">
        <div class="form-group">
            <label>من تاريخ</label>
            <input type="date" name="FromDate" value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group">
            <label>إلى تاريخ</label>
            <input type="date" name="ToDate" value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-Prim">بحث</button>
        <a href="@Url.Action("UserActivity")" class="btn btn-secondary">تفريغ</a>
        <a asp-controller="AuditLogs" asp-action="Index" class="btn btn-secondary">عرض السجل الكامل</a>
    </form>
</div>

<div class="stats-grid" style="margin-top:16px;">
    <div class="stat-card">
        <div class="num">@Model.Rows.Count</div>
        <div class="label">عدد المستخدمين النشطين</div>
    </div>
    <div class="stat-card">
        <div class="num">@Model.TotalActions</div>
        <div class="label">إجمالي العمليات</div>
    </div>
</div>

<div class="card" style="margin-top:16px;">
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>المستخدم</th>
                    <th>عدد العمليات</th>
                    <th>آخر عملية</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.UserName</td>
                        <td>@r.ActionsCount</td>
                        <td class="muted">@r.LastActionDate?.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="3" class="muted" style="text-align:center; padding:24px;">لا يوجد نتائج</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
