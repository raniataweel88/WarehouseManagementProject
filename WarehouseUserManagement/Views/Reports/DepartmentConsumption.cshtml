@model DepartmentConsumptionViewModel
@{
    ViewData["Title"] = "أكثر الأقسام استهلاكاً";
}

<div class="page-title">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Index" class="btn btn-secondary">⟵ قائمة التقارير</a>
</div>

<div class="card">
    <form method="get" class="toolbar">
        <div class="form-group">
            <label>من تاريخ</label>
            <input type="date" name="FromDate" value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group">
            <label>إلى تاريخ</label>
            <input type="date" name="ToDate" value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-Prim">بحث</button>
        <a href="@Url.Action("DepartmentConsumption")" class="btn btn-secondary">تفريغ</a>
    </form>
</div>

<div class="card" style="margin-top:16px;">
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>القسم</th>
                    <th>كمية الصرف</th>
                    <th>النسبة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.DepartmentName</td>
                        <td>@r.TotalQuantity</td>
                        <td>@r.Percentage.ToString("N1")%</td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="3" class="muted" style="text-align:center; padding:24px;">لا يوجد نتائج</td></tr>
                }
            </tbody>
            @if (Model.Rows.Any())
            {
                <tfoot>
                    <tr>
                        <th>الإجمالي</th>
                        <th>@Model.GrandTotal</th>
                        <th>100%</th>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
