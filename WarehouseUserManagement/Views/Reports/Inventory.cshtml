@model InventoryReportViewModel
@{
    ViewData["Title"] = Model.Filter.OnlyLowStock ? "تقرير الأصناف الناقصة" : "تقرير المخزون الحالي";
}

<div class="page-title">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Index" class="btn btn-secondary">⟵ قائمة التقارير</a>
</div>

<div class="card">
    <form method="get" class="toolbar">
        <div class="form-group">
            <label>بحث (اسم الصنف)</label>
            <input type="search" name="SearchTerm" value="@Model.Filter.SearchTerm" placeholder="اكتب للبحث..." />
        </div>
        <div class="form-group">
            <label>التصنيف</label>
            <select name="CategoryId">
                <option value="">الكل</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.CategoryId" selected="@(Model.Filter.CategoryId == c.CategoryId)">@c.CategoryName</option>
                }
            </select>
        </div>
        <div class="form-group" style="align-self:flex-end;">
            <label style="display:flex; align-items:center; gap:6px;">
                <input type="checkbox" name="OnlyLowStock" value="true" checked="@Model.Filter.OnlyLowStock" />
                فقط الأصناف الناقصة عن الحد الأدنى
            </label>
        </div>
        <button type="submit" class="btn btn-Prim">بحث</button>
        <a href="@Url.Action("Inventory")" class="btn btn-secondary">تفريغ</a>
        <a href="@Url.Action("InventoryCsv", new { Model.Filter.SearchTerm, Model.Filter.CategoryId, Model.Filter.IsActive, Model.Filter.OnlyLowStock })" class="btn btn-secondary">⬇ تصدير Excel/CSV</a>
    </form>
</div>

<div class="stats-grid" style="margin-top:16px;">
    <div class="stat-card">
        <div class="num">@Model.TotalItems</div>
        <div class="label">عدد الأصناف</div>
    </div>
    <div class="stat-card">
        <div class="num">@Model.TotalQuantity</div>
        <div class="label">إجمالي الكمية</div>
    </div>
    <div class="stat-card">
        <div class="num">@Model.TotalValue.ToString("N2")</div>
        <div class="label">قيمة المخزون الإجمالية</div>
    </div>
</div>

<div class="card" style="margin-top:16px;">
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>الصنف</th>
                    <th>التصنيف</th>
                    <th>الوحدة</th>
                    <th>الكمية الحالية</th>
                    <th>الحد الأدنى</th>
                    <th>متوسط التكلفة</th>
                    <th>قيمة المخزون</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr class="@(r.IsLowStock ? "status-warning" : "")">
                        <td>@(r.IsLowStock ? "⚠ " : "")@r.ProductName</td>
                        <td>@r.CategoryName</td>
                        <td>@r.Unit</td>
                        <td>@r.CurrentQuantity</td>
                        <td>@r.MinimumQuantity</td>
                        <td>@r.AverageCost.ToString("N4")</td>
                        <td>@r.TotalValue.ToString("N2")</td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="7" class="muted" style="text-align:center; padding:24px;">لا يوجد نتائج</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
