@model UserListViewModel
@{
    ViewData["Title"] = "المستخدمون";
    bool IsAdmin = User.HasClaim("perm", "*");
    HashSet<string> RolePermissions = new(StringComparer.OrdinalIgnoreCase);
    if (!IsAdmin && int.TryParse(User.FindFirst("RoleId")?.Value, out var currentRoleId))
    {
        RolePermissions = await PermissionService.GetPermissionNamesForRoleAsync(currentRoleId);
    }
    bool Has(string perm) => IsAdmin || RolePermissions.Contains(perm);

}

<div class="page-title">
    <h2>إدارة المستخدمين</h2>

    @if (Has("Add User"))
    {
        <button class="btn btn-Prim"
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#createUserModal">
            إضافة مستخدم
        </button>
    }
 


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

    
</div>

<div class="card">
    <form method="get" class="toolbar">
        <div class="form-group">
            <label>بحث (اسم / Username)</label>
            <input type="search" name="SearchTerm" value="@Model.SearchTerm" placeholder="اكتب للبحث..." />
        </div>
        <div class="form-group">
            <label>الدور</label>
            
                <select name="RoleFilter">
                    <option value="">الكل</option>

                    @foreach (var r in Model.AvailableRoles)
                    {
                        <option value="@r.RoleName" selected="@(r.RoleName == Model.RoleFilter)">
                            @r.RoleName
                        </option>
                    }

                
            </select>
        </div>
        <button type="submit" class="btn btn-Prim">بحث</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">تفريغ</a>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>الاسم الكامل</th>
                    <th>Username</th>
                    <th>الدور</th>
                    <th>البريد الإلكتروني</th>
                    <th>الحالة</th>
                     <th class="actions-col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>@u.FullName</td>
                        <td>@u.Username</td>
                        <td>@u.RoleName</td>
                        <td>@(u.Email ?? "-")</td>
                        <td>
                            @if (u.IsLocked)
                            {
                                <span class="status-pill status-locked">موقوف (محاولات)</span>
                            }
                            else if (u.IsActive)
                            {
                                <span class="status-pill status-active">نشط</span>
                            }
                            else
                            {
                                <span class="status-pill status-inactive">غير مفعل</span>
                            }
                        </td>
                      
                        <td class="actions-cell">
                            <button class="btn btn-sm btn-secondary detailsUserBtn"
                                    data-id="@u.UserId">
                                عرض
                            </button>
                            @if (Has("Edit User"))
                            {
                                <button class="btn btn-sm btn-secondary editUserBtn"
                                        data-id="@u.UserId">
                                    تعديل
                                </button>
                            }
                            @if (Has("Reset Password"))
                            {
                                <button class="btn btn-sm btn-secondary resetPasswordBtn"
                                        data-id="@u.UserId">
                                    كلمة المرور
                                </button>
                            }
                            @if (Has("Disable User"))
                            {
                                <form asp-action="ToggleActive" asp-route-id="@u.UserId" method="post" style="display:inline"
                                      data-confirm="هل أنت متأكد؟">
                                    @if (u.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-danger">إيقاف</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-success">تفعيل</button>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Users.Any())
                {
                    <tr><td colspan="7" class="muted" style="text-align:center; padding:24px;">لا يوجد نتائج</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination">
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <a class="@(p == Model.PageNumber ? "active" : "")"
               href="@Url.Action("Index", new { SearchTerm = Model.SearchTerm, RoleFilter = Model.RoleFilter, PageNumber = p, PageSize = Model.PageSize })">@p</a>
        }
    </div>
    <p class="muted">إجمالي النتائج: @Model.TotalCount</p>
</div>

<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <form asp-action="Create" method="post">

                <div class="modal-header">
                    <h5 class="modal-title" id="createUserModalLabel">
                        إضافة مستخدم جديد
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">الاسم الكامل</label>
                            <input name="FullName" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">اسم المستخدم</label>
                            <input name="Username" class="form-control" autocomplete="off" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">كلمة المرور</label>
                            <input name="Password"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <small class="text-muted">
                                8 أحرف على الأقل، حرف كبير، حرف صغير، رقم، ورمز خاص.
                            </small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">الدور</label>

                            <select name="RoleId" class="form-select">
                                <option value="">-- اختر الدور --</option>

                                @foreach (var r in Model.AvailableRoles)
                                {
                                    <option value="@r.RoleId">@r.RoleName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">البريد الإلكتروني</label>
                            <input name="Email" type="email" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">الهاتف</label>
                            <input name="Phone" class="form-control" />
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="IsActive"
                                       value="true"
                                       checked />

                                <label class="form-check-label">
                                    الحساب مفعل
                                </label>
                            </div>
                        </div>

                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        إلغاء
                    </button>

                    <button type="submit" class="btn btn-Prim">
                        حفظ
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="editUserContent">
        </div>
    </div>
</div>
<div class="modal fade" id="userActionModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="userActionContent">
        </div>
    </div>
</div>
<script>
    const createUserModal = document.getElementById('createUserModal');

    createUserModal.addEventListener('hidden.bs.modal', function () {
        const form = this.querySelector('form');

        // إعادة تعيين جميع الحقول
        form.reset();

        // إزالة رسائل التحقق إن وجدت
        form.querySelectorAll('.text-danger').forEach(e => {
            if (!e.classList.contains('validation-summary-errors')) {
                e.textContent = '';
            }
        });
    });

        document.querySelectorAll(".editUserBtn").forEach(btn => {

        btn.addEventListener("click", function () {

            let id = this.dataset.id;

            fetch('/Users/Edit/' + id)
                .then(r => r.text())
                .then(html => {

                    document.getElementById("editUserContent").innerHTML = html;

                    new bootstrap.Modal(document.getElementById("editUserModal")).show();

                });

        });

    });
        function openUserModal(url) {

        fetch(url)
            .then(r => r.text())
            .then(html => {

                document.getElementById("userActionContent").innerHTML = html;

                new bootstrap.Modal(
                    document.getElementById("userActionModal")
                ).show();

            });
    }


    // Details
    document.querySelectorAll(".detailsUserBtn").forEach(btn => {

        btn.addEventListener("click", function () {

            let id = this.dataset.id;

            openUserModal('/Users/Details/' + id);

        });

    });


    // Reset Password
    document.querySelectorAll(".resetPasswordBtn").forEach(btn => {

        btn.addEventListener("click", function () {

            let id = this.dataset.id;

            openUserModal('/Users/ResetPassword/' + id);

        });

    });
</script>