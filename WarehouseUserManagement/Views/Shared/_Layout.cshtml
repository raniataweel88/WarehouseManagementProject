@{
    bool IsAuthed = User.Identity?.IsAuthenticated ?? false;
    bool IsAdmin = User.HasClaim("perm", "*");
    HashSet<string> RolePermissions = new(StringComparer.OrdinalIgnoreCase);
    if (IsAuthed && !IsAdmin && int.TryParse(User.FindFirst("RoleId")?.Value, out var currentRoleId))
    {
        // نقرأ صلاحيات الدور الحالية من الكاش (يُفرَّغ تلقائياً عند أي تعديل على صلاحيات الدور)
        // بدل الاعتماد على Claims قديمة محفوظة وقت تسجيل الدخول، حتى تنعكس أي تغييرات فوراً.
        RolePermissions = await PermissionService.GetPermissionNamesForRoleAsync(currentRoleId);
    }
    bool Has(string perm) => IsAdmin || RolePermissions.Contains(perm);
    string CurrentController = (string)ViewContext.RouteData.Values["controller"]! ?? "";
    bool IsCurrent(string controller) => string.Equals(CurrentController, controller, StringComparison.OrdinalIgnoreCase);
    string? SuccessMessage = TempData["Success"] as string;
    string? ErrorMessage = TempData["Error"] as string;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#4F46E5" />
    <title>@ViewData["Title"] - نظام إدارة المستودعات</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    @if (IsAuthed)
    {
        <input type="checkbox" id="nav-toggle" class="nav-toggle" />
        <label for="nav-toggle" class="sidebar-overlay"></label>

        <div class="app-shell">
            <aside class="sidebar">
                <a class="brand" asp-controller="Home" asp-action="Index">📦 إدارة المستودعات</a>

                <nav class="sidebar-nav">
                    <a asp-controller="Home" asp-action="Index" class="@(IsCurrent("Home") && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <span class="nav-icon">🏠</span> الرئيسية
                    </a>
                    <a asp-controller="Home" asp-action="Dashboard" class="@(IsCurrent("Home") && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                        <span class="nav-icon">📈</span> لوحة المعلومات
                    </a>

                    <div class="sidebar-section">إدارة المستودع</div>
                    @if (Has("View Category"))
                    {
                        <a asp-controller="Categories" asp-action="Index" class="@(IsCurrent("Categories") ? "active" : "")">
                            <span class="nav-icon">🗂️</span> التصنيفات
                        </a>
                    }
                    @if (Has("View Product"))
                    {
                        <a asp-controller="Products" asp-action="Index" class="@(IsCurrent("Products") ? "active" : "")">
                            <span class="nav-icon">📦</span> الأصناف
                        </a>
                    }
                    @if (Has("View Purchase Invoices"))
                    {
                        <a asp-controller="PurchaseInvoices" asp-action="Index" class="@(IsCurrent("PurchaseInvoices") ? "active" : "")">
                            <span class="nav-icon">🧾</span> فواتير الشراء
                        </a>
                    }
                    @if (Has("View Issues"))
                    {
                        <a asp-controller="Issues" asp-action="Index" class="@(IsCurrent("Issues") ? "active" : "")">
                            <span class="nav-icon">📤</span>  الصادر
                        </a>
                    }
                    @if (Has("View StockTake"))
                    {
                        <a asp-controller="StockTake" asp-action="Index" class="@(IsCurrent("StockTake") ? "active" : "")">
                            <span class="nav-icon">📋</span> الجرد
                        </a>
                    }
                    @if (Has("View Old Invoices Archive"))
                    {
                        <a asp-controller="OldInvoiceArchive" asp-action="Index" class="@(IsCurrent("OldInvoiceArchive") ? "active" : "")">
                            <span class="nav-icon">🗄️</span> أرشيف فواتير قديمة
                        </a>
                    }
                    @if (Has("View Departments"))
                    {
                        <a asp-controller="Departments" asp-action="Index" class="@(IsCurrent("Departments") ? "active" : "")">
                            <span class="nav-icon">🏢</span> الأقسام
                        </a>
                    }

                    <div class="sidebar-section">النظام والصلاحيات</div>
                    @if (Has("View Users"))
                    {
                        <a asp-controller="Users" asp-action="Index" class="@(IsCurrent("Users") ? "active" : "")">
                            <span class="nav-icon">👤</span> المستخدمون
                        </a>
                    }
                    @if (Has("Manage Roles"))
                    {
                        <a asp-controller="Roles" asp-action="Index" class="@(IsCurrent("Roles") ? "active" : "")">
                            <span class="nav-icon">🛡️</span> الأدوار
                        </a>
                    }
                    @if (Has("Manage Permissions"))
                    {
                        <a asp-controller="Permissions" asp-action="Index" class="@(IsCurrent("Permissions") ? "active" : "")">
                            <span class="nav-icon">🔑</span> الصلاحيات
                        </a>
                    }
                  
                    @if (Has("View Inventory Report") || Has("View Purchase Report") || Has("View Issue Report") || Has("View StockTake") || Has("View Audit Log"))
                    {
                        <div class="sidebar-section">التقارير</div>
                        <a asp-controller="Reports" asp-action="Index" class="@(IsCurrent("Reports") ? "active" : "")">
                            <span class="nav-icon">📊</span> التقارير و Dashboard
                        </a>
                    }
                </nav>

                <div class="sidebar-user">
                    <div class="sidebar-user-info">
                        <span class="sidebar-user-name">👤 @User.FindFirstValue("FullName")</span>
                        <span class="badge">@User.FindFirstValue(ClaimTypes.Role)</span>
                    </div>
                    <button type="button" class="link-btn mb-2" style="width:100%;" onclick="openChangePasswordModal()">
                        🔒 تغيير كلمة المرور
                    </button>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="link-btn" style="width:100%;">خروج</button>
                    </form>
                </div>
            </aside>

            <div class="modal fade" id="changePasswordModal" tabindex="-1">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content" id="changePasswordContent">
                    </div>
                </div>
            </div>
            <script>
                function openChangePasswordModal() {
                    fetch('/Account/ChangePassword')
                        .then(r => r.text())
                        .then(html => {
                            document.getElementById("changePasswordContent").innerHTML = html;
                            new bootstrap.Modal(document.getElementById("changePasswordModal")).show();
                            bindChangePasswordForm();
                        });
                }

                function bindChangePasswordForm() {
                    var container = document.getElementById("changePasswordContent");
                    var form = container.querySelector("form");
                    if (!form) return;

                    form.addEventListener("submit", function (e) {
                        e.preventDefault();

                        var formData = new FormData(form);

                        fetch(form.action, {
                            method: "POST",
                            body: formData,
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        })
                        .then(function (r) {
                            var contentType = r.headers.get("content-type") || "";
                            if (contentType.indexOf("application/json") !== -1) {
                                return r.json().then(function (data) { return { isJson: true, data: data }; });
                            }
                            return r.text().then(function (html) { return { isJson: false, html: html }; });
                        })
                        .then(function (result) {
                            if (result.isJson && result.data.success) {
                                // نجاح: اعرض رسالة تأكيد بنفس ستايل التطبيق (SweetAlert2)، وسكّر المودال بعدها
                                Swal.fire({
                                    icon: 'success',
                                    title: 'تم بنجاح',
                                    text: result.data.message,
                                    confirmButtonText: 'حسناً',
                                    confirmButtonColor: '#F04E23'
                                }).then(function () {
                                    var modalEl = document.getElementById("changePasswordModal");
                                    var modalInstance = bootstrap.Modal.getInstance(modalEl);
                                    if (modalInstance) modalInstance.hide();
                                });
                            } else {
                                // فشل التحقق (مثلاً كلمة المرور الحالية غلط): أعد عرض الفورم
                                // داخل نفس المودال مع رسائل الخطأ بدل ما يخرج على صفحة عارية
                                container.innerHTML = result.html;
                                bindChangePasswordForm();
                            }
                        });
                    });
                }
            </script>

            <div class="main-area">
                <header class="app-topbar">
                    <label for="nav-toggle" class="nav-toggle-label" aria-label="فتح القائمة">
                        <span></span>
                    </label>
                    <span class="app-topbar-title">@ViewData["Title"]</span>
                </header>

                <main class="container">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main>
            @RenderBody()
        </main>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @if (SuccessMessage != null || ErrorMessage != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                @if (SuccessMessage != null)
                {
                    @:Swal.fire({ icon: 'success', title: 'تم بنجاح', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SuccessMessage)), confirmButtonText: 'حسناً', confirmButtonColor: '#F04E23' });
                }
                @if (ErrorMessage != null)
                {
                    @:Swal.fire({ icon: 'error', title: 'حدث خطأ', text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ErrorMessage)), confirmButtonText: 'حسناً', confirmButtonColor: '#F04E23' });
                }
            });
        </script>
    }

    @RenderSection("Scripts", required: false)
</body>
</html>