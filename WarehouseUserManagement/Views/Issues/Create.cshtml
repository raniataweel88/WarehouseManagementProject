@model IssueFormViewModel
@{
    ViewData["Title"] = "سند صرف جديد";
}
<style>
    .form-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .scan-flash {
        background-color: #d1f7dd !important;
        transition: background-color 0.7s ease;
    }
</style>

<div class="page-title">
    <h2>سند صرف جديد</h2>
    <a asp-action="Index" class="btn btn-secondary">رجوع للقائمة</a>
</div>

<form asp-action="Create" method="post" id="issueForm">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card">
        <div class="form-grid">

            <div class="form-group">
                <label asp-for="IssueNumber"></label>
                <input asp-for="IssueNumber" class="form-control" />
                <span asp-validation-for="IssueNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IssueDate"></label>
                <input asp-for="IssueDate" type="date" class="form-control" value="@Model.IssueDate.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="IssueDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DepartmentId"></label>
                <select asp-for="DepartmentId" class="form-control">
                    <option value="">-- اختر القسم --</option>
                    @foreach (var d in Model.DepartmentOptions)
                    {
                        <option value="@d.DepartmentId">@d.DepartmentName</option>
                    }
                </select>
                <span asp-validation-for="DepartmentId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ReceiverName"></label>
                <input asp-for="ReceiverName" class="form-control" />
                <span asp-validation-for="ReceiverName" class="text-danger"></span>
            </div>

            <div class="form-group full-width">
                <label asp-for="Notes"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>

        </div>
    </div>

    <div class="card">
        <div class="page-title" style="margin-bottom:12px;">
            <h2 style="font-size:18px;">أصناف السند</h2>
            <button type="button" id="addLineBtn" class="btn btn-sm btn-secondary">+ إضافة سطر</button>
        </div>

        <div class="form-group full-width" style="margin-bottom:16px;">
            <label for="barcodeScanInput">مسح الباركود</label>
            <input type="text" id="barcodeScanInput" class="form-control" placeholder="🔫 امسح الباركود بالسكانر أو اكتبه واضغط Enter" autocomplete="off" />
        </div>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th style="min-width:260px;">الصنف</th>
                        <th style="width:140px;">الكمية</th>
                        <th style="width:140px;">المتوفر بالمخزون</th>
                        <th style="width:60px;"></th>
                    </tr>
                </thead>
                <tbody id="linesBody">
                </tbody>
            </table>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-Prim">حفظ كمسودة</button>
        <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
    </div>
</form>

<!-- ===== قائمة بحث الأصناف (Searchable Dropdown) - عنصر واحد مشترك يُستخدم لأي سطر ===== -->
<div id="productDropdown" class="product-dropdown">
    <input type="text" id="productSearchInput" class="form-control product-dropdown-search" placeholder="🔍 ابحث عن صنف..." autocomplete="off" />
    <div id="productDropdownList" class="product-dropdown-list"></div>
</div>

@section Scripts {
<script id="productOptionsData" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProductOptions, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
</script>
<script>
    // نمنع مفتاح Enter من إرسال الفورم مباشرة وهو المستخدم عم يعبّي حقول السطر (الكمية، السعر، ...)
    // - لازم يضغط على زر الحفظ فعلياً حتى تُرسل الفاتورة/العملية
    var mainFormIssueForm = document.getElementById('issueForm');

    mainFormIssueForm.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
            e.preventDefault();
        }
    });

    // شبكة أمان إضافية: أي إرسال "ضمني" (Enter) ما يترافق مع submitter (يعني ما حدا ضغط فعلياً
    // على زر الحفظ) يتم تجاهله، حتى لو نجا من منع الـ keydown لأي سبب (متصفح/نوع حقل مختلف)
    mainFormIssueForm.addEventListener('submit', function (e) {
        if (!e.submitter) {
            e.preventDefault();
        }
    });

    function normalizeProduct(p) {
        return {
            productId: Number(p.productId ?? p.ProductId),
            productName: p.productName ?? p.ProductName ?? '',
            categoryName: p.categoryName ?? p.CategoryName ?? '',
            barcode: p.barcode ?? p.Barcode ?? '',
            unit: p.unit ?? p.Unit ?? '',
            currentQuantity: Number(p.currentQuantity ?? p.CurrentQuantity ?? 0)
        };
    }

    const products = JSON.parse(document.getElementById('productOptionsData').textContent).map(normalizeProduct);
    const linesBody = document.getElementById('linesBody');
    let lineIndex = 0;

    // ===== عناصر قائمة بحث الأصناف =====
    const productDropdown = document.getElementById('productDropdown');
    const productSearchInput = document.getElementById('productSearchInput');
    const productDropdownList = document.getElementById('productDropdownList');

    let activeCell = null;   // خلية الصنف المفتوحة حالياً للبحث

    function escapeHtml(str) {
        return String(str ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function findProduct(id) {
        return products.find(p => p.productId === Number(id));
    }

    // كل الأصناف المختارة حالياً في باقي سطور السند (لمنع تكرار نفس الصنف)
    function usedProductIds(excludeCell) {
        const ids = [];
        linesBody.querySelectorAll('.product-picker').forEach(cell => {
            if (cell === excludeCell) return;
            const val = cell.querySelector('.line-product-id').value;
            if (val) ids.push(Number(val));
        });
        return ids;
    }

    function setCellLabel(cell, product) {
        const label = cell.querySelector('.product-picker-label');
        if (product) {
            label.textContent = `${product.productName} (${product.categoryName})`;
            label.classList.remove('placeholder-text');
        } else {
            label.textContent = '-- اختر الصنف --';
            label.classList.add('placeholder-text');
        }
    }

    function selectProduct(cell, productId) {
        const product = findProduct(productId);
        if (!product) return;

        if (usedProductIds(cell).includes(product.productId)) {
            closeDropdown();
            Swal.fire({
                icon: 'warning',
                title: 'الصنف مضاف مسبقاً',
                text: 'هذا الصنف موجود بالفعل في السند.'
            });
            return;
        }

        cell.querySelector('.line-product-id').value = product.productId;
        setCellLabel(cell, product);

        const row = cell.closest('tr');
        row.querySelector('.line-available').textContent = `${product.currentQuantity} ${product.unit}`;
        row.querySelector('.line-qty').dataset.max = product.currentQuantity;
        checkQtyAgainstStock(row);

        closeDropdown();
    }

    function renderDropdownList(term) {
        const t = (term || '').trim().toLowerCase();
        const excluded = activeCell ? usedProductIds(activeCell) : [];
        const matches = products.filter(p => {
            if (excluded.includes(p.productId)) return false;
            if (!t) return true;
            return p.productName.toLowerCase().includes(t) || p.categoryName.toLowerCase().includes(t) || (p.barcode && p.barcode.toLowerCase().includes(t));
        });

        if (matches.length === 0) {
            productDropdownList.innerHTML = '<div class="product-dropdown-empty">لا توجد نتائج مطابقة</div>';
            return;
        }

        productDropdownList.innerHTML = matches.map(p => `
            <button type="button" class="product-dropdown-item" data-id="${p.productId}">
                <span class="pdi-name">${escapeHtml(p.productName)}</span>
                <span class="pdi-meta">${escapeHtml(p.categoryName)} · ${escapeHtml(p.unit)} · متوفر: ${p.currentQuantity}${p.barcode ? " · " + escapeHtml(p.barcode) : ""}</span>
            </button>
        `).join('');
    }

    function positionDropdown(cell) {
        const btn = cell.querySelector('.product-picker-btn');
        const rect = btn.getBoundingClientRect();
        const dropdownWidth = Math.max(rect.width, 260);
        productDropdown.style.width = `${dropdownWidth}px`;

        // نقيس ارتفاع القائمة الفعلي (بعد ما صارت ظاهرة ومليانة بالنتائج) حتى نعرف
        // إذا في مسافة كافية تحت الحقل، وإلا نفتحها فوقه بدل ما تنقص عن حدود الشاشة
        const dropdownHeight = productDropdown.offsetHeight;
        const spaceBelow = window.innerHeight - rect.bottom;
        const spaceAbove = rect.top;

        if (spaceBelow < dropdownHeight + 8 && spaceAbove > spaceBelow) {
            productDropdown.style.top = `${Math.max(8, rect.top - dropdownHeight - 4)}px`;
        } else {
            const top = Math.min(rect.bottom + 4, window.innerHeight - dropdownHeight - 8);
            productDropdown.style.top = `${Math.max(8, top)}px`;
        }

        productDropdown.style.left = `${rect.left}px`;
    }

    function openDropdown(cell) {
        activeCell = cell;
        productDropdown.style.display = 'block';

        // نملأ القائمة قبل حساب موضعها حتى يكون ارتفاعها الحقيقي جاهز للقياس
        productSearchInput.value = '';
        renderDropdownList('');

        positionDropdown(cell);
        productSearchInput.focus();
    }

    function closeDropdown() {
        productDropdown.style.display = 'none';
        activeCell = null;
    }

    document.addEventListener('click', function (e) {
        if (productDropdown.style.display !== 'block') return;
        if (productDropdown.contains(e.target)) return;
        if (e.target.closest('.product-picker-btn')) return;
        closeDropdown();
    });

    window.addEventListener('scroll', function (e) {
        if (!activeCell) return;
        if (productDropdown.contains(e.target)) return;
        positionDropdown(activeCell);
    }, true);

    window.addEventListener('resize', function () {
        if (activeCell) positionDropdown(activeCell);
    });

    productSearchInput.addEventListener('input', () => renderDropdownList(productSearchInput.value));

    productDropdownList.addEventListener('click', function (e) {
        const item = e.target.closest('.product-dropdown-item');
        if (!item || !activeCell) return;
        selectProduct(activeCell, item.dataset.id);
    });

    function productPickerHtml(idx, productId) {
        const product = productId ? findProduct(productId) : null;
        const label = product ? `${product.productName}  ` : '-- اختر الصنف --';
        const placeholderClass = product ? '' : 'placeholder-text';
        return `
            <div class="product-picker">
                <input type="hidden" class="line-product-id" name="Lines[${idx}].ProductId" value="${productId || ''}" />
                <button type="button" class="form-control product-picker-btn text-start">
                    <span class="product-picker-label ${placeholderClass}">${label}</span>
                </button>
            </div>
        `;
    }

    // تحذير بصري فقط (لا يمنع الإرسال) إن كانت الكمية أكبر من المتوفر - التحقق الملزم يتم في السيرفر وقت الاعتماد
    function checkQtyAgainstStock(row) {
        const qtyInput = row.querySelector('.line-qty');
        const qty = parseFloat(qtyInput.value) || 0;
        const max = parseFloat(qtyInput.dataset.max || '0');
        if (max > 0 && qty > max) {
            qtyInput.classList.add('is-invalid');
        } else {
            qtyInput.classList.remove('is-invalid');
        }
    }

    function addLine(productId, quantity) {
        const idx = lineIndex++;
        const product = productId ? findProduct(productId) : null;
        const row = document.createElement('tr');
        row.innerHTML = `
            <td>${productPickerHtml(idx, productId)}</td>
            <td><input type="number" step="0.001" min="0.001" class="form-control line-qty" name="Lines[${idx}].Quantity" value="${quantity || ''}" data-max="${product ? product.currentQuantity : ''}" /></td>
            <td class="line-available muted">${product ? (product.currentQuantity + ' ' + product.unit) : '-'}</td>
            <td><button type="button" class="btn btn-sm btn-danger removeLineBtn">حذف</button></td>
        `;
        linesBody.appendChild(row);
        wireRow(row);
    }

    function wireRow(row) {
        const qty = row.querySelector('.line-qty');
        const removeBtn = row.querySelector('.removeLineBtn');
        const cell = row.querySelector('.product-picker');
        const pickerBtn = cell.querySelector('.product-picker-btn');

        qty.addEventListener('input', () => checkQtyAgainstStock(row));

        pickerBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            if (activeCell === cell) { closeDropdown(); return; }
            openDropdown(cell);
        });

        removeBtn.addEventListener('click', function () {
            if (linesBody.children.length <= 1) return; // خلّي سطر واحد على الأقل
            if (activeCell === cell) closeDropdown();
            row.remove();
        });
    }

    document.getElementById('addLineBtn').addEventListener('click', () => addLine());

    // ===== مسح الباركود (سكانر) وإضافة/زيادة الصنف تلقائياً على السند =====
    const barcodeScanInput = document.getElementById('barcodeScanInput');

    function flashRow(row) {
        row.classList.add('scan-flash');
        setTimeout(() => row.classList.remove('scan-flash'), 700);
    }

    function findRowByProductId(productId) {
        return Array.from(linesBody.querySelectorAll('tr')).find(row =>
            Number(row.querySelector('.line-product-id').value) === Number(productId));
    }

    function findEmptyRow() {
        return Array.from(linesBody.querySelectorAll('tr')).find(row =>
            !row.querySelector('.line-product-id').value);
    }

    function scanBarcode() {
        const code = barcodeScanInput.value.trim();
        barcodeScanInput.value = '';
        if (!code) return;

        const product = products.find(p => p.barcode && p.barcode.toLowerCase() === code.toLowerCase());
        if (!product) {
            Swal.fire({ icon: 'warning', title: 'صنف غير موجود', text: `لا يوجد صنف بالباركود: ${code}` });
            barcodeScanInput.focus();
            return;
        }

        const existingRow = findRowByProductId(product.productId);
        if (existingRow) {
            const qtyInput = existingRow.querySelector('.line-qty');
            qtyInput.value = (parseFloat(qtyInput.value) || 0) + 1;
            qtyInput.dispatchEvent(new Event('input'));
            flashRow(existingRow);
            barcodeScanInput.focus();
            return;
        }

        const emptyRow = findEmptyRow();
        if (emptyRow) {
            const cell = emptyRow.querySelector('.product-picker');
            selectProduct(cell, product.productId);
            const qtyInput = emptyRow.querySelector('.line-qty');
            qtyInput.value = 1;
            qtyInput.dispatchEvent(new Event('input'));
            flashRow(emptyRow);
        } else {
            addLine(product.productId, 1);
            flashRow(linesBody.lastElementChild);
        }

        barcodeScanInput.focus();
    }

    barcodeScanInput.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        e.stopPropagation();
        scanBarcode();
    });

    // سطر واحد فارغ عند البدء
    addLine();
</script>
}
